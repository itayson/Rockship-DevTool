<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rock_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RockFlash DevTool"
            android:textColor="@color/rock_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Rockchip Loader/MaskROM no Android"
            android:textColor="@color/rock_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_waiting"
                android:textColor="@color/rock_warning"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/deviceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:textColor="@color/rock_text"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/safetyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/rock_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scanButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/scan" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/permissionButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/request_access" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openNativeButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_native" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/armbianWizardButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_armbian_wizard" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Diagnóstico e backup"
            android:textColor="@color/rock_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="2"
            android:useDefaultMargins="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/listButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/list_devices" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/read_chip" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/flashIdButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/read_flash_id" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/flashInfoButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/read_flash" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/capabilityButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/read_capability" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/partitionsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="@string/print_partitions" />
        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/panel_background"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gravação, ROM, custom ROM e Armbian"
                android:textColor="@color/rock_error"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Imagens .img e .img.xz são aceitas. Uma imagem Armbian para SD não é automaticamente compatível com NAND."
                android:textColor="@color/rock_warning"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selectImageButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/select_image" />

            <TextView
                android:id="@+id/selectedImageText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="Nenhum arquivo preparado"
                android:textColor="@color/rock_muted"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/startSectorInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Setor inicial para imagem bruta (normalmente 0)"
                android:inputType="number"
                android:text="0"
                android:textColor="@color/rock_text"
                android:textColorHint="@color/rock_muted" />

            <EditText
                android:id="@+id/partitionInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nome da partição: boot, recovery, system..."
                android:inputType="text"
                android:textColor="@color/rock_text"
                android:textColorHint="@color/rock_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/flashRawButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/flash_raw" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/flashPartitionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/flash_partition" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/downloadLoaderButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="@string/download_loader" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/upgradeLoaderButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="@string/upgrade_loader" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/writeGptButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="@string/write_gpt" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/writeParameterButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:text="@string/write_parameter" />
            </GridLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/eraseFlashButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/erase_flash" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetDeviceButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reset_device" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copyReportButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/copy_report" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearLogButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/clear_log" />
        </LinearLayout>

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/panel_background"
            android:fontFamily="monospace"
            android:minHeight="260dp"
            android:padding="14dp"
            android:textColor="@color/rock_text"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
